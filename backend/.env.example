NODE_ENV=development
PORT=3001

# AWS Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS Cognito
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# AWS S3
AWS_S3_DOCUMENT_BUCKET=intelexp-documents-dev

# AWS RDS (PostgreSQL)
AWS_RDS_HOST=localhost
AWS_RDS_PORT=5432
AWS_RDS_USERNAME=postgres
AWS_RDS_PASSWORD=postgres
AWS_RDS_DATABASE=intelexp

# AWS OpenSearch & Neptune
AWS_OPENSEARCH_ENDPOINT=
AWS_NEPTUNE_ENDPOINT=

# AI Configuration
AI_GATEWAY_PROVIDER=aws-bedrock
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
OPENAI_API_KEY=
