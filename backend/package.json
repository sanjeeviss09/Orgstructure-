{
  "name": "antigravity-backend",
  "version": "1.0.0",
  "description": "Superdatabase Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --ignore \"src/data/*.json\" src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/data', {recursive:true}); fs.copyFileSync('src/data/db.json', 'dist/data/db.json'); fs.copyFileSync('src/data/db_seed.json', 'dist/data/db_seed.json');\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^1.1.1",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
